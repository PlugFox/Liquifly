{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "app:debug",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/app",
            "args": [
                //"--dart-define-from-file=config/staging.env",
                //"--flavor=staging"
            ]
            /* "preLaunchTask": "dart:build_runner:all" */
        },
        {
            "name": "core:debug:lib",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--lib"
                ],
                "filter": {
                    "name": "liquifly",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/core",
            "preLaunchTask": "core:cargo:build"
        },
        {
            "name": "core:debug:tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib"
                ],
                "filter": {
                    "name": "liquifly",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/core"
        },
        {
            "name": "core:debug:bench",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "bench",
                    "--no-run"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}/core"
        }
    ]
}